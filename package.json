{
  "name": "shopzy",
  "version": "1.0.0",
  "private": true,
  "description": "SHOPZY - Local business discovery & price comparison platform",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "node scripts/audit.mjs",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.2",
    "docx": "^9.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "pptxgenjs": "^4.0.1",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=20"
  }
}
