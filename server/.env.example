# ---- Core ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Leave MONGODB_URI empty in development to auto-start an in-memory MongoDB
# (mongodb-memory-server). For production use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/shopzy?retryWrites=true&w=majority
MONGODB_URI=

# ---- Cache (optional; falls back to in-process LRU when unset) ----
REDIS_URL=

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ---- OTP ----
# When SMS provider is not configured the OTP is logged & returned in dev responses
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Uploads ----
# storage: local | cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Rate limits (requests per window) ----
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=5
RATE_LIMIT_SEARCH=10

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@shopzy.in
SEED_ADMIN_PASSWORD=Admin@1234
