# ==============================================================================
# SHOPZY PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to `.env` on your staging or production server.
# Ensure all secrets are replaced with cryptographically secure values (>= 32 chars).
# ==============================================================================

# ---- Core Runtime ----
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
# Comma-separated list of allowed client origins (no trailing slashes):
CLIENT_ORIGIN=https://shopzy.in,https://www.shopzy.in
TRUST_PROXY=1

# ---- Database (MongoDB Atlas Replica Set) ----
# Connection string with retryWrites, w=majority, and replicaSet:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopzy?retryWrites=true&w=majority

# ---- Caching & Distributed Sessions (Redis) ----
# Connection URL for managed Redis (Upstash, AWS ElastiCache, or Redis Cloud):
REDIS_URL=rediss://default:<redis_token>@<redis_host>:6379

# ---- Authentication & Security ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-ultra-secure-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-ultra-secure-random-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ---- OTP & SMS Notification Gateway ----
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
# Indian SMS Gateway (MSG91) or International (Twilio):
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Media Uploads & Storage ----
# In production, use cloudinary or s3 instead of local disk:
STORAGE_DRIVER=cloudinary
MAX_UPLOAD_MB=5
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- Rate Limiting (Requests per window per IP) ----
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AUTH=8
RATE_LIMIT_SEARCH=30

# ---- Production Seed / Admin Bootstrap ----
# Only set when initializing first super-admin account on a clean database:
SEED_ADMIN_EMAIL=admin@shopzy.in
SEED_ADMIN_PASSWORD=ReplaceWithStrongAdminPassword!2026
